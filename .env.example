# Copy this file to .env and fill in your values:  cp .env.example .env && chmod 600 .env
# .env is in .gitignore — never commit it.

IMAP_USER=saif.turky@sunnydaysegypt.com
# 16-character Google App Password (spaces are fine, they are removed)
IMAP_APP_PASSWORD=

# Optional: Gmail API (read-only OAuth). Needed in cloud sessions where IMAP is blocked.
# Client ID/secret from Google Cloud (see README); the refresh token is written by `python mail_tool.py auth`.
GMAIL_CLIENT_ID=
GMAIL_CLIENT_SECRET=
GMAIL_REFRESH_TOKEN=

# Optional: needed only for --summarize / the summarize command
ANTHROPIC_API_KEY=

# Used by the summaries to flag what concerns you
MY_NAME=سيف تركي
MY_ROLE=العضو المنتدب لمجموعة الفنادق
